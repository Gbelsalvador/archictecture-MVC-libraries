DB_HOST=127.0.0.1
DB_NAME=database_name
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Secret pour signer les JWT (HS256)
JWT_SECRET=change_me_in_production

# URL de base (optionnel)
BASE_URL=http://localhost:8000
# Expiration des tokens JWT (en secondes)
JWT_ACCESS_TOKEN_EXPIRY=
JWT_REFRESH_TOKEN_EXPIRY=

# Configuration de l'application
APP_ENV=development
APP_DEBUG=true
 
# Mail / SMTP configuration (utilisé par Utils\Mailer)
# Si vous utilisez SMTP, renseignez SMTP_HOST, SMTP_USER et SMTP_PASS
MAIL_FROM=no-reply@localhost
MAIL_FROM_NAME="No Reply"
SMTP_HOST=
SMTP_AUTH=1
SMTP_USER=
SMTP_PASS=
SMTP_PORT=587
SMTP_SECURE=

